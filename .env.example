VITE_FIREBASE_API_KEY="replace-with-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="project-id"
VITE_FIREBASE_STORAGE_BUCKET="project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="replace-with-sender-id"
VITE_FIREBASE_APP_ID="replace-with-app-id"
VITE_FIREBASE_APP_CHECK_SITE_KEY="replace-with-enterprise-site-key"
VITE_USE_FIREBASE_EMULATORS="true"
