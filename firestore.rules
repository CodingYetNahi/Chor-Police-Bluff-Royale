rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function member(roomId) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)); }
    match /players/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /rooms/{roomId} {
      allow read: if member(roomId);
      allow write: if false;
      match /members/{uid} { allow read: if member(roomId); allow write: if false; }
      match /privateState/{uid} { allow read: if member(roomId) && request.auth.uid == uid; allow write: if false; }
      match /actions/{id} { allow read: if member(roomId); allow write: if false; }
      match /votes/{uid} { allow read, write: if false; }
      match /{serverData=**} { allow read, write: if false; }
    }
    match /cases/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /entitlements/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /paymentOrders/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /payments/{id} { allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['reporterUid','category','content','roomId','createdAt']) && request.resource.data.reporterUid == request.auth.uid && request.resource.data.category is string && request.resource.data.category.size() <= 40 && request.resource.data.content is string && request.resource.data.content.size() >= 5 && request.resource.data.content.size() <= 500;
      allow read, update, delete: if admin();
    }
    match /systemConfig/{id} { allow read, write: if admin(); }
    match /matchStats/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
